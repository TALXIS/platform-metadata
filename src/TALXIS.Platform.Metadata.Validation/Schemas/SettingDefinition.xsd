<?xml version="1.0" encoding="utf-8"?>
<xs:schema id="SettingDefinition" xmlns:xs="http://www.w3.org/2001/XMLSchema">
	<xs:element name="settingdefinition">
		<xs:complexType>
			<xs:sequence>
				<xs:any minOccurs="0" maxOccurs="unbounded" processContents="skip" />
			</xs:sequence>
			<xs:attribute name="uniquename" type="xs:string" use="optional" />
			<xs:attribute name="solutionaction" type="solutionactionType" use="optional" />
		</xs:complexType>
	</xs:element>
</xs:schema>
