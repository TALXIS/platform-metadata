<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TALXIS.Platform.Metadata.Serialization.Xml</RootNamespace>
    <PackageId>TALXIS.Platform.Metadata.Serialization.Xml</PackageId>
    <Description>SolutionPackager XML serialization for TALXIS Platform Metadata. Roundtrip-safe read/write of Dataverse solution workspace files.</Description>
    <Title>TALXIS Platform Metadata Serialization XML</Title>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="10.0.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.0" />
    <ProjectReference Include="../TALXIS.Platform.Metadata/TALXIS.Platform.Metadata.csproj" />
    <ProjectReference Include="../TALXIS.Platform.Metadata.Workspace/TALXIS.Platform.Metadata.Workspace.csproj" />
    <Using Include="TALXIS.Platform.Metadata.Workspaces" />
  </ItemGroup>

</Project>
