<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TALXIS.Platform.Metadata.Validation</RootNamespace>
    <PackageId>TALXIS.Platform.Metadata.Validation</PackageId>
    <Description>XSD schema validation and structural checking for Dataverse solution workspaces. Depends on TALXIS.Platform.Metadata core model.</Description>
    <Title>TALXIS Platform Metadata Validation</Title>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schemas\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.1" />
    <PackageReference Include="PolySharp" Version="1.15.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../TALXIS.Platform.Metadata/TALXIS.Platform.Metadata.csproj" />
  </ItemGroup>

</Project>
